<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="40dp"
        tools:context=".CreerBudjet"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="60dp"
            android:background="@drawable/fond_vert"
            android:gravity="center"
            android:padding="15dp"
            android:text="Nouvelle Enveloppe"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />

        <LinearLayout
            android:layout_width="411dp"
            android:layout_height="match_parent"

            android:orientation="vertical"
            android:padding="40dp"
            tools:context=".MdpOublieActivite">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:padding="15dp"
                android:text="Titre de votre enveloppe:"
                android:textColor="#FF000000"
                android:textSize="19dp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/nom"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="50dp"
                android:background="@drawable/fond_gris"
                android:hint="Nom"
                android:padding="15dp"
                android:textColor="#FF000000" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:padding="15dp"
                android:text="Budjet alloué à votre enveloppe:"
                android:textColor="#FF000000"
                android:textSize="19dp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/montant"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/fond_gris"
                android:hint="Montant"
                android:padding="15dp"
                android:textColor="#FF000000"

                />


            <Button
                android:id="@+id/enveloppeCree"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="30dp"
                android:backgroundTint="#AADD66"
                android:text="Ajouter mon enveloppe"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/annuler"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="30dp"
                android:backgroundTint="#AADD66"
                android:text="Annuler"
                android:textColor="#E93939" />

        </LinearLayout>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>