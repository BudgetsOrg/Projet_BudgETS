<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTitrePage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nouvel Objectif Commun"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#0B5C3F"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etTitre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Titre de l'objectif (ex: Vacances)"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitrePage" />

    <EditText
        android:id="@+id/etMontant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Montant cible ($)"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/etTitre" />

    <TextView
        android:id="@+id/tvInvite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inviter un partenaire par courriel :"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/etMontant"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etEmailInvite"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="courriel@exemple.com"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/tvInvite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnAjouterEmail" />

    <Button
        android:id="@+id/btnAjouterEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+"
        android:backgroundTint="#AADD66"
        app:layout_constraintBottom_toBottomOf="@id/etEmailInvite"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvListeEmails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Participants : Aucun"
        android:textColor="#555555"
        app:layout_constraintTop_toBottomOf="@id/etEmailInvite" />

    <Button
        android:id="@+id/btnCreer"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="CRÉER L'OBJECTIF"
        android:backgroundTint="#0B5C3F"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>