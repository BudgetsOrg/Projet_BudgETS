<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvTitrePage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nouvel Objectif Commun"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#0B5C3F"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- BUG XML FIX : etTitre et etMontant n'avaient pas de constraintStart
         ni constraintEnd → positionnement imprévisible sur certains appareils -->
    <EditText
        android:id="@+id/etTitre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Titre de l'objectif (ex: Vacances)"
        android:inputType="text"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitrePage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etMontant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Montant cible ($)"
        android:inputType="numberDecimal"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/etTitre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvInvite"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Inviter un partenaire par courriel :"
        android:textColor="#333333"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/etMontant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etEmailInvite"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="courriel@exemple.com"
        android:inputType="textEmailAddress"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvInvite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnAjouterEmail" />

    <Button
        android:id="@+id/btnAjouterEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+"
        android:textSize="20sp"
        android:backgroundTint="#AADD66"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@id/etEmailInvite"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvListeEmails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Participants : Aucun"
        android:textColor="#555555"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@id/etEmailInvite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnCreer"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="CRÉER L'OBJECTIF"
        android:backgroundTint="#0B5C3F"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>