<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#9DBA7C"
    >
    <LinearLayout
        tools:context=".MdpOublieActivite"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp">

        <TextView
            android:text="Mot de passe oublié"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            />

        <EditText
            android:id="@+id/email2"
            android:hint="Adresse courriel"
            android:inputType="textEmailAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            />

        <Button
            android:id="@+id/envoyerCode"
            android:text="Envoyer code"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF000000"
            android:layout_width="match_parent"
            android:layout_marginTop="30dp"
            android:layout_height="50dp"/>

        <Button
            android:id="@+id/retourConnexion2"
            android:text="Retour connexion"
            android:textColor="#1E2A3A"
            android:backgroundTint="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_marginTop="30dp"
            android:layout_height="50dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>