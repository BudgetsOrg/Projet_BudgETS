<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#9DBA7C"
    >


    <LinearLayout
        tools:context=".ModificationMdpActivite"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp">

        <TextView
            android:text="Réinitialiser mot de passe"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/code"
            android:hint="Code de validation"

            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/nouveauMdp"
            android:hint="Nouveau mot de passe"
            android:inputType="textPassword"

            android:padding="15dp"
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/changerMdp"
            android:text="Changer mot de passe"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF000000"
            android:layout_marginTop="25dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>

        <Button
            android:id="@+id/retourConnexion3"
            android:text="Retour connexion"
            android:textColor="#1E2A3A"
            android:backgroundTint="#FFFFFF"
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>