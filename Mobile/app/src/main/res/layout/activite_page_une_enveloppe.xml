<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/titreEnveloppe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Titre de mon enveloppe"
            android:textColor="#000000"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Budget alloué: "
                android:textColor="#9E9E9E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/budgetMontant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150$"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pourcentageDepense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="15dp"
            android:text="0%"
            android:textColor="#9E9E9E"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="114dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Depense"
                android:textColor="#9E9E9E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAjouterDepense"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:backgroundTint="#AADD66"
                android:text="Ajouter +"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <View
                android:layout_width="1dp"
                android:layout_height="25dp"
                android:layout_marginHorizontal="15dp"
                android:background="#D3D3D3" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#F0F0F0"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Titre"
                android:textColor="#757575"
                android:textStyle="bold"
                android:gravity="start" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Prix"
                android:textColor="#757575"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Date"
                android:textColor="#757575"
                android:textStyle="bold"
                android:gravity="end" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDepenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>