<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        tools:context=".AccueilFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- En-tête profil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:padding="5dp">

            <ImageView
                android:id="@+id/ImgProfil"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/img1"
                android:background="@drawable/img_ronde"
                android:scaleType="centerCrop"
                android:clipToOutline="true" />

        </LinearLayout>

        <!-- Contenu principal — gravity="start" au lieu de "center"
             pour que le RecyclerView s'affiche correctement après notifyDataSetChanged() -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mes budgETS"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="20dp" />

            <!-- Solde du mois -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Solde pour le mois :"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:textSize="16sp" />

                <!-- BUG XML 1 FIX : soldeMois est maintenant lu ET mis à jour
                     depuis l'API dans AccueilFragment.java (soldeTotalMois en mémoire).
                     Le champ reste affichable mais n'est plus la source de vérité. -->
                <EditText
                    android:id="@+id/soldeMois"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="0$"
                    android:textColor="#9A000000"
                    android:textSize="16sp"
                    android:inputType="numberDecimal" />

            </LinearLayout>

            <TextView
                android:id="@+id/enveloppes"
                android:layout_width="250dp"
                android:layout_height="50dp"
                android:background="@drawable/fond_vert"
                android:padding="10dp"
                android:textAlignment="center"
                android:text="Mes enveloppes:"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="10dp" />

            <!-- Message "aucune enveloppe" -->
            <TextView
                android:id="@+id/message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vous n'avez aucune enveloppe pour le moment"
                android:textColor="#9A000000"
                android:textSize="16sp"
                android:layout_marginBottom="10dp" />

            <!-- BUG XML 2 FIX : minHeight ajouté pour forcer le rendu même quand la liste
                 est vide, évitant le problème de RecyclerView invisible dans ScrollView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listeEnveloppes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:nestedScrollingEnabled="false"
                android:minHeight="1dp" />

            <Button
                android:id="@+id/creerBudjet"
                android:text="Créer un budjet"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#FF000000"
                android:layout_marginTop="10dp"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Section "Récemment consulté" -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Récemment consulté"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="16sp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recemmentConsulte"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:nestedScrollingEnabled="false" />

        <!-- Cercle de progression -->
        <FrameLayout
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp">

            <ProgressBar
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:progress="100"
                android:progressDrawable="@drawable/cercle_fond_gris"
                style="?android:attr/progressBarStyleHorizontal" />

            <ProgressBar
                android:id="@+id/diagramme"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:rotation="-90"
                android:progressDrawable="@drawable/progression_cercle"
                style="?android:attr/progressBarStyleHorizontal" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/pourcentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="20sp"
                    android:textColor="#FF000000" />

            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</ScrollView>